# Copy to .env and adjust: cp .env.example .env
# compose.yml reads these through ${VAR} interpolation.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=confera
POSTGRES_PASSWORD=change_me
POSTGRES_DB=confera_development
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Container user (match `id -u` / `id -g` on your host) -------------------
HOST_UID=1000
HOST_GID=1000

# --- RabbitMQ ----------------------------------------------------------------
# User/password are only read on the FIRST boot of an empty rabbitmq_data
# volume. Changing them later means removing that volume.
RABBITMQ_USER=confera
RABBITMQ_PASSWORD=change_me
# Must use the same user/password as above; the host is the compose service name.
RABBITMQ_URL=amqp://confera:change_me@rabbitmq:5672

# --- Mail (Mailpit in development) -------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
